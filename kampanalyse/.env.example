# Kopier til .env og fyll inn. .env skal ALDRI sjekkes inn i git.
# Filrettigheter: chmod 600 .env

# --- Telegram (hent token fra @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Din numeriske Telegram-ID (f.eks. fra @userinfobot). Kun denne brukeren får tilgang i starten.
OWNER_TELEGRAM_ID=
# Privat kanal for publisering. La stå tom – settes bare etter uttrykkelig beslutning.
PUBLISH_CHANNEL_ID=

# --- Datakilde ---
# demo = fiktive eksempeldata (ingen nøkler). apifootball = ekte data (krever nøkkel).
DATA_PROVIDER=demo
APIFOOTBALL_KEY=
# Sikkerhetsgrense for antall API-kall per døgn (Pro-plan: 7500)
APIFOOTBALL_DAILY_CAP=7000

# Valgfritt, eksperimentelt: tredjepartskilde for Norsk Tipping-priser (odds-api.io).
# Priser herfra merkes «NT via tredjepart – kontroller i Oddsen».
ODDSAPIIO_KEY=

# --- Tider (Europe/Oslo) ---
RESEARCH_TIME=06:15
BRIEF_TIME=08:00
REPORT_TIME=23:30

# --- Ligaer (API-Football-ID[:navn], kommaseparert). Tom = standardlisten i config.py ---
LEAGUES=

# --- Analyse ---
MODEL_WEIGHT=0.25
MIN_EDGE=0.03
MIN_QUALITY=0.55
ENABLE_CARDS=0
ENABLE_CORNERS=0
LIVE_POLL_SECONDS=60
# Maks én ekstra publiseringsrunde per dag (kan settes til 0, ikke høyere enn 1)
MAX_EXTRA_ROUNDS=1

DB_PATH=data/kampanalyse.db
