# Copy to /etc/fxsignal/fxsignal.env (chmod 600, owner fxsignal). Never commit the real file.
# --- price feed (OANDA v20; a free practice account works) ---
OANDA_API_TOKEN=
OANDA_HOST=https://api-fxpractice.oanda.com
# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=          # your private chat with the bot (numeric)
TELEGRAM_ADMIN_IDS=              # comma-separated numeric user IDs allowed to run commands
TELEGRAM_CHANNEL_ID=             # broadcast channel; only used for strategies that passed the gates
# --- watchdog ---
WATCHDOG_HEALTH_URL=http://127.0.0.1:8087/health
WATCHDOG_RESTART_CMD=            # e.g. "systemctl restart fxsignal" (needs a sudoers rule) - optional
DEADMAN_PING_URL=                # e.g. a healthchecks.io ping URL - strongly recommended
